# Copy to .env and replace all secrets before running.
POSTGRES_DB=devicepulse
POSTGRES_USER=devicepulse
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DEVICEPULSE_ADMIN_USERNAME=admin
DEVICEPULSE_ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
DEVICEPULSE_AUTH_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEVICEPULSE_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
MQTT_HOST=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=devicepulse/kiosk/heartbeat
DEVICEPULSE_API_PORT=8081
DEVICEPULSE_DASHBOARD_PORT=8082
