# Copy these settings into your existing .env file; never commit real credentials.
# Keep all existing DevicePulse DATABASE_URL / MQTT settings unchanged.

# Set true only after configuring the channel credentials.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

ALERT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALERT_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Watchdog policy (existing values; do not change unless intended)
DEVICE_SUSPECT_SECONDS=120
DEVICE_OFFLINE_SECONDS=180

# Start in dry-run mode; integration instructions below explain how to test.
ALERT_DRY_RUN=true
