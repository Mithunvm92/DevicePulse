services:
  api:
    build:
      context: ./backend
    container_name: devicepulse-backend
    restart: unless-stopped
    ports:
      - "8081:8080"
    environment:
      MQTT_HOST: test.mosquitto.org
      MQTT_PORT: "1883"
      MQTT_TOPIC: devicepulse/kiosk/heartbeat
      DATABASE_URL: postgresql://devicepulse:devicepulse_dev_only@db:5432/devicepulse
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    container_name: devicepulse-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: devicepulse
      POSTGRES_USER: devicepulse
      POSTGRES_PASSWORD: devicepulse_dev_only
    volumes:
      - devicepulse_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U devicepulse -d devicepulse"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  devicepulse_db_data:

  dashboard:
    image: nginx:alpine
    container_name: devicepulse-dashboard
    ports:
      - "8082:80"
    volumes:
      - ./dashboard:/usr/share/nginx/html:ro
    restart: unless-stopped

  dashboard:
    image: nginx:alpine
    container_name: devicepulse-dashboard
    ports:
      - "8082:80"
    volumes:
      - ./dashboard:/usr/share/nginx/html:ro
    restart: unless-stopped
