# Copy to the DevicePulse project root as .env and fill in unique values.
# Do not commit .env or share it. Use strong random values for all keys/passwords.

DEVICEPULSE_ADMIN_USERNAME=admin
DEVICEPULSE_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
DEVICEPULSE_AUTH_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEVICEPULSE_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# MQTT and database settings remain in docker-compose.yml; do not change them here.
